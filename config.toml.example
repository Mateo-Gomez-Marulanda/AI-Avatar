# Copia este archivo como config.toml y ajusta los comandos a tu equipo.

idle_states = ["sentado", "parado"]
idle_switch_s = 20.0
bubble_ms_per_char = 45
drag_snap_ms = 250
quiet_zone = "no_molestar"

[provider]
command = ["opencode", "run", "--format", "json", "--agent", "alive", "--archived"]
output_format = "json"
workdir = "~"
timeout_s = 90.0

[apps]
firefox = "firefox --new-window"
code = "code"
terminal = "konsole"

[commands]
enabled = true
timeout_s = 30.0
max_output_bytes = 8192
max_per_turn = 3
approval_timeout_s = 120.0
working_dir = "~"
share_output_with_model = false
# La salida no viaja al proveedor y el turno termina sin segunda llamada al modelo

[conversation]
max_chars = 6000

[music]
enabled = true
players = ["spotify"]
poll_s = 5.0

# El avatar se ancla justo debajo del panel superior (margin = altura del panel).
[zones.barra]
anchor = "top"
margin = 32

[zones.izquierda]
anchor = "left"
margin = 12

[zones.derecha]
anchor = "right"
margin = 12

[zones.flotante]
anchor = "floating"
x = 400
y = 300

# «No molestar» lleva el avatar a esta esquina y deja pasar los clics.
[zones.no_molestar]
anchor = "bottom-right"
margin = 12

[voice]
# Sustituye por tus comandos reales. Con enabled=false se oculta el micrófono
# y no se registran atajos de voz; las listas vacías desactivan cada paso.
stt_command = ["whisper-cli", "-m", "models/ggml-tiny.bin", "-f", "-"]
tts_command = ["piper", "--model", "models/voice.onnx", "--output_raw"]
play_command = ["paplay", "--raw", "--format=s16le", "--rate=16000", "--channels=1"]
capture_command = ["ffmpeg", "-f", "pulse", "-i", "default", "-t", "{duration}", "-f", "s16le", "-"]
sample_rate = 16000
frame_samples = 1024
timeout_s = 30.0
enabled = true
