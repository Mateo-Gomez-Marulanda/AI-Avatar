# Copia este archivo como config.toml y ajusta los comandos a tu equipo.

[provider]
# CLI que responde. Por defecto OpenCode; otros ejemplos: ["claude", "-p"], ["codex", "exec"]
command = ["opencode", "run"]
# oneshot envía el historial en cada llamada, sin depender de ids de sesión.
session_mode = "oneshot"
# Solo se usan en resume si el CLI admite reanudar por id.
session_flag = ""
session_id_regex = ""
timeout_s = 60.0
# El modelo NO recibe información de animación: solo conversación y estas dos órdenes:
#   ESTADO=sentado|parado|musica   ABRIR=<alias de [apps]>
# Cualquier otra línea ZONA=... o ESTADO=hablando se ignora.
prompt_template = "{history}\n{text}"

# El modelo puede pedir ABRIR=alias solo con alias de esta lista.
[apps]
firefox = "firefox --new-window"
code = "code"
terminal = "konsole"

# El avatar se ancla justo debajo del panel superior (margin = altura del panel).
[zones.barra]
anchor = "top"
margin = 32

[zones.izquierda]
anchor = "left"
margin = 12

[zones.derecha]
anchor = "right"
margin = 12

[zones.flotante]
anchor = "floating"
x = 400
y = 300

[voice]
# Sustituye por tus comandos reales. Con enabled=false se oculta el micrófono
# y no se registran atajos de voz; las listas vacías desactivan cada paso.
stt_command = ["whisper-cli", "-m", "models/ggml-tiny.bin", "-f", "-"]
tts_command = ["piper", "--model", "models/voice.onnx", "--output_raw"]
play_command = ["paplay", "--raw", "--format=s16le", "--rate=16000", "--channels=1"]
capture_command = ["ffmpeg", "-f", "pulse", "-i", "default", "-t", "{duration}", "-f", "s16le", "-"]
sample_rate = 16000
frame_samples = 1024
timeout_s = 30.0
enabled = true
